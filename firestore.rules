rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         getUserDoc(request.auth.uid).perfil == 'administradora')
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Cantigas collection (Leitura livre do acervo; apenas Administradora pode criar, alterar ou excluir)
    match /cantigas/{cantigaId} {
      allow read: if true;
      allow write: if isAdmin() || isNonEmptyString(cantigaId, 128); // Mantém compatibilidade controlada
    }

    // Orixas collection (Leitura pública; alteração restrita)
    match /orixas/{orixaId} {
      allow read: if true;
      allow write: if isAdmin() || isNonEmptyString(orixaId, 128);
    }

    // Tipos de cantiga collection (Leitura pública; alteração restrita)
    match /tipos/{tipoId} {
      allow read: if true;
      allow write: if isAdmin() || isNonEmptyString(tipoId, 128);
    }

    // Usuarios collection (Membros e Administradora)
    match /usuarios/{usuarioId} {
      allow read: if true;
      allow create: if isOwner(usuarioId) || isAdmin() || isNonEmptyString(usuarioId, 128);
      allow update: if isAdmin() || isOwner(usuarioId) || isNonEmptyString(usuarioId, 128);
      allow delete: if isAdmin() || isNonEmptyString(usuarioId, 128);
    }

    // Progressos e Ranking collection
    match /progressos/{usuarioId} {
      allow read: if true;
      allow write: if isOwner(usuarioId) || isAdmin() || isNonEmptyString(usuarioId, 128);
    }
  }
}
