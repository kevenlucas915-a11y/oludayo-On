rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for non-empty string validation
    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Cantigas collection
    match /cantigas/{cantigaId} {
      allow read: if true;
      allow write: if isNonEmptyString(cantigaId, 128);
    }

    // Orixas collection
    match /orixas/{orixaId} {
      allow read: if true;
      allow write: if isNonEmptyString(orixaId, 128);
    }

    // Tipos de cantiga collection
    match /tipos/{tipoId} {
      allow read: if true;
      allow write: if isNonEmptyString(tipoId, 128);
    }

    // Usuarios collection (membros e administradora)
    match /usuarios/{usuarioId} {
      allow read: if true;
      allow write: if isNonEmptyString(usuarioId, 128);
    }

    // Progressos e Ranking collection
    match /progressos/{usuarioId} {
      allow read: if true;
      allow write: if isNonEmptyString(usuarioId, 128);
    }
  }
}
